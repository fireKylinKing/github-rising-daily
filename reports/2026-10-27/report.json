  "errors": [],
  "editorial": {
    "enabled": true,
    "headline": "代理技能与本地工作台同榜",
    "gainIntro": "今天主榜几乎被编码代理的周边占满：一边是给代理补设计感、做安全审计、跑 SEO 的“技能”，一边是把多个代理装进桌面、IDE 和终端的“工作台”。此外还有本地语音工具、多智能体金融研究框架，以及一台会走路的鸭子机器人，类型相当分散。",
    "risingIntro": "上升区更多是刚起步的小项目：有把屏幕录制变成可复用技能的微软工具，有压缩上下文以撑长会话的插件，也有把 DeepSeek Harness 接进九种即时通讯渠道的插件。另有自托管家庭计划、生成式 UI 框架和 3D 高斯泼溅训练器，整体偏实用。",
    "projects": {
      "795775446": {
        "tagline": "一个二进制跑完 3D 高斯泼溅",
        "summary": "跨厂商的 3D Gaussian Splatting 训练器：单个二进制完成从照片视频到 splat 再到带纹理网格，内置 SfM 与 AI 遮罩，走 Vulkan 可运行在 NVIDIA、AMD、Intel 和 Apple GPU 上。",
        "observation": "README 称 8GB 显存能训千万级全 SH 高斯，原生支持鱼眼与 360 度素材，近期还加了度量尺度恢复和编辑渲染。相比 Python 方案省去环境配置，画质与速度仍值得自行对比。"
      },
      "866958830": {
        "tagline": "原神自动化工具的社区脚本仓库",
        "summary": "原神自动化工具 BetterGI 的社区脚本仓库：收录 JS 脚本、地图采集路线、自动战斗策略和七圣召唤策略，并对目录命名、注释署名、测试数据与提交格式给出详细规范。",
        "observation": "README 明确规定由 AI 生成的战斗策略不予接受，要求提交实战耗时与对比数据，还限制脚本内 HTML 遮罩不得用于推广。这类游戏自动化脚本的合规与账号风险，需要使用者自行判断。"
      },
      "897268988": {
        "tagline": "用紧凑语言边收边渲染界面",
        "summary": "生成式 UI 的开源框架：用一套紧凑、可流式解析的 OpenUI Lang 描述界面，从组件库自动生成提示词，再在 React、Vue、Svelte、Angular 里边收 token 边渲染，README 称比 JSON 更省 token。",
        "observation": "核心思路是让模型输出受组件库约束的结构化界面，而不是放任自由文本；仓库提供脚手架和在线演练场。生成 UI 的稳定性与可访问性，可能比 token 节省更值得长期观察。"
      },
      "909213664": {
        "tagline": "多角色协同的金融研究框架",
        "summary": "多智能体 LLM 金融交易研究框架：把分析师、研究员、交易员和风控拆成不同角色协同推理，并配套回测、数据源接入与决策日志，README 记录了近几个月密集的版本迭代。",
        "observation": "更新日志强调时点一致性与回测防未来函数、每个模型层可换用不同供应商、报告导出为单页 HTML。它属于研究框架而非投资建议，回测表现并不等于实盘结果，这点值得使用者自行留意。"
      },
      "1051789550": {
        "tagline": "知道代理在忙什么的终端窗口管理器",
        "summary": "用 Go 写的终端窗口管理器与复用器：类 vim 的模态操作、BSP 平铺、多工作区与会话守护，还让窗格里的编码代理上报状态、互相发消息，并汇总到一个收件箱。",
        "observation": "README 开头专门声明有人在 X 上冒名，项目只在本仓库和 tuios.dev 发布，也没有代币。它用 WebAssembly 提供在线试用，会话守护与跨机连接是卖点，配置复杂度值得先翻文档。"
      },
      "1097346685": {
        "tagline": "给 AI 前端补一套设计规范",
        "summary": "面向 AI 编码代理的设计指导：一条命令初始化产品背景，提供 polish、audit、critique、bolder 等 24 条命令，以及 62 条无需大模型的确定性检测规则，专门挑出模板化前端写法。",
        "observation": "README 把问题归为各模型共享的同一套 SaaS 模板审美，并列出反模式清单；检测规则可在命令行与浏览器扩展里离线运行，不需 API key。团队能否长期采纳，可能取决于规则与自家设计规范是否冲突。"
      },
      "1136590548": {
        "tagline": "给代理加规则、记忆与安全层",
        "summary": "面向 Claude Code、Codex、Cursor 等代理的“脚手架优化系统”：以技能、直觉规则、记忆、安全与研究优先流程来约束代理行为，README 提供多语言说明以及 npm 包和 GitHub App 等安装方式。",
        "observation": "README 特意警示只从官方仓库、npm 包和 GitHub App 安装，说明这类套装已有仿冒风险。它体量很大，实际收益可能取决于团队是否愿意长期维护这套规则，先小范围试用更稳妥。"
      },
      "1152014594": {
        "tagline": "Claude Code 里的免费 SEO 审计",
        "summary": "Claude Code 里的免费 SEO 插件：输入站点就跑技术抓取、内容质量、结构化数据、AI 搜索可见度、本地与电商检查，由 26 个子技能和 19 个专职代理分工，最后给出排好优先级的行动清单。",
        "observation": "README 称一次审计约 10 到 15 分钟，并会解释每条建议的理由和验证方式；部分实时数据能力依赖可选扩展。更适合当作检查清单与写作助手，排名结果仍受搜索算法与站点本身影响。"
      },
      "1190598050": {
        "tagline": "跑在自家 NAS 上的家庭计划",
        "summary": "自托管家庭计划 PWA：任务、日历、预算、菜单与购物、健康、文档等 20 个模块放在一个容器里，运行在自己的服务器或 NAS 上，用一个 SQLite 文件存数据，不做追踪。",
        "observation": "README 强调模块互通，例如一周菜单能一键导出按货架排序的购物清单，勾掉的采购还能回填库存。相比订阅制应用是否更省心，可能取决于家庭成员的接受度与自托管的维护成本。"
      },
      "1206390571": {
        "tagline": "本地跑的音色克隆与配音工具箱",
        "summary": "面向个人和小团队的本地语音工具箱：克隆音色、按描述设计嗓音、给视频配音、口述转写和制作有声书，README 称覆盖 646 种语言，模型运行在自己的硬件上。",
        "observation": "它以 Electron 桌面应用形式提供，并留出本地 API 与 MCP 供代理调用；默认引擎基于 OmniVoice，也支持切换与可选远程服务。功能面很广，实际效果值得按语言和硬件自行验证。"
      },
      "1206425593": {
        "tagline": "图像视频生成与品牌素材技能包",
        "summary": "Higgsfield 官方的一组代理技能：在 Claude Code、Cursor 等工具里生成图像、视频、3D 和音频，还包括训练可复用的人像身份模型、产品图拍摄、品牌套件、YouTube 封面与整站搭建。",
        "observation": "技能之间可以串联，例如先训练身份模型再把参考 id 用在生成任务里；安装方式覆盖 npx skills、gh skill 与插件市场。多数能力依赖官方服务与账号，实际可用度可能受额度与地区影响。"
      },
      "1222917575": {
        "tagline": "让代理做出不像 AI 生成的页面",
        "summary": "给 Claude Code、Cursor、Codex 等编码代理用的设计技能：从 48 套主题里选题材，按访客来意排版，并在真实浏览器里检查“一眼像 AI”的常见痕迹，例如每个标题上方的眉标、只有图片没有内容的整页。",
        "observation": "README 把检查分成硬性底线、模型默认反射和润色三档，最后由一个全新上下文的审查者复核；它还支持给 URL 或本地服务自动截图、按路径重做页面。设计偏好主观性强，落地效果可能因项目而异。"
      },
      "1273427276": {
        "tagline": "六阶段、可校验的代理安全审计",
        "summary": "把编码代理变成安全审计员的技能：先摸清架构与信任边界，再按覆盖清单分派多个隔离代理找漏洞，候选问题交给独立验证者尝试反驳，最后输出可机器校验的结论文件。",
        "observation": "README 说明它源自 Cloudflare 自建漏洞发现流水线的单仓起点，审计分六阶段，含覆盖率台账与 findings 校验脚本，对同一仓库多次运行可累加。误报率与适用范围仍值得在真实仓库中观察。"
      },
      "1293238217": {
        "tagline": "JetBrains 孵化的代理式 IDE",
        "summary": "JetBrains 孵化中的 agentic IDE：围绕 pi 编码代理做界面，把每个任务放进独立 git worktree 工作区并行运行，用“活规格”和可复用技能沉淀项目知识，同时保留 Monaco 编辑器、终端与文件视图。",
        "observation": "README 详细描述了工作区合并、PR 状态展示、把 review 评论转成上下文的流程，改动可以直接变成草稿合入。作为孵化项目功能会变动，扩展机制尚未完成，更适合愿意尝鲜的开发者。"
      },
      "1309102418": {
        "tagline": "开箱即用的多执行器本地代理",
        "summary": "开箱即用的本地 AI 代理客户端，含桌面与移动端：把 Claude Code、Codex 等执行器与模型混搭起来跑真实项目，任务中途可换模型，而工作区、记忆和技能保持连续。",
        "observation": "仓库只是开源客户端，后端服务在另一处，部分能力需登录云端；README 也说明可以跳过登录，只用本地代理。多执行器编排是它区别于单一工具的地方，稳定性与费用结构值得观察。"
      },
      "1315850547": {
        "tagline": "会走会翻滚的迷你双足鸭机器人",
        "summary": "Pollen Robotics 的小型双足机器人“大脑”仓库：约 25 厘米、800 克的鸭子由 RK3566 上的守护进程驱动，50 Hz 控制循环运行神经网络策略，会走、会滚、会捡东西，摔倒后能自己起来。",
        "observation": "策略训练在同组织的 microduck_rl 仓库，用 MuJoCo 与 PPO 训练后导出 ONNX；本仓库负责运行时、带签名更新与回滚，并提供仿真脚本。硬件门槛和价格决定了它更适合机器人教学与实验。"
      },
      "1316443307": {
        "tagline": "录一遍操作，生成可复用技能",
        "summary": "微软的桌面录制工具：录下你在屏幕上的真实操作、可选的终端命令与语音解说，用 GitHub Copilot 还原成意图加有序步骤，再生成代理可复用的 SKILL.md，或按计划运行的自动化。",
        "observation": "README 强调生成的技能优先调用代理原生工具而不是重放点击，并从一次示例推广到同类任务；安装脚本按提交固定版本，需要 Copilot 权限。一次录制能否稳妥泛化，仍值得实测。"
      },
      "1324949198": {
        "tagline": "靠压缩上下文撑长会话的插件",
        "summary": "一个上下文压缩插件，目标是让单次会话撑到月级、数十亿 token，同时让 100K 窗口够用并省下 token；README 列出 Claude Code、Codex、Gemini CLI 等一长串已适配的编码代理。",
        "observation": "省 token 与长会话天然矛盾，压缩质量决定了它能否真正替代频繁开新会话，而压缩难免丢失细节。插件适配面很广，但仓库未标注许可证，长期维护与兼容性可能值得观察。"
      },
      "1332461149": {
        "tagline": "多代理常驻的本地桌面工作区",
        "summary": "本地优先的桌面工作区，让多个 AI 代理长期驻留：Codex、Claude、Grok 等各占独立工作区与会话，配有任务队列、文件互传、内嵌浏览器和代理间消息，可跨桌面与移动端使用。",
        "observation": "README 明确警告这是开发预览，代理以完全文件访问、无需逐步确认的方式运行，需要自担风险并做好备份，许可证为非商业。多代理协作的实际协调成本值得在真实任务中观察。"
      },
      "1334561781": {
        "tagline": "把编码代理接进九种即时通讯",
        "summary": "把 DeepSeek Harness 接进即时通讯的插件：通过扫码或机器人凭据，让飞书、微信、钉钉、企业微信、QQ、Slack、Telegram、Discord、WhatsApp 等九个渠道都能与代理对话。",
        "observation": "项目自称获得 DeepSeek Harness 官方赞助，README 里列了不少分发渠道与榜单徽章。对想在群里直接用编码代理的团队来说门槛较低，但凭据托管方式与消息隐私边界值得先弄清楚。"
      }
